ORY_SDK_URL=https://your-project.projects.oryapis.com
ORY_ACCESS_TOKEN=ory_pat_...
HTTPS_PROXY=
NO_PROXY=
# Only for scripts/seed-keto.sh (Ory CLI): which project to seed
ORY_PROJECT=
ORY_WORKSPACE=
# Let the /api proxy delete relation tuples (the live-mode node delete). Off by default.
ALLOW_TUPLE_DELETE=
# Hostnames the server answers on (DNS-rebinding protection); default localhost,127.0.0.1,[::1]
ALLOWED_HOSTS=
